    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  rp.asin,\n  rp.brand,\n  pr.review_text,\n  pr.rate\nFROM raw_products rp\nINNER JOIN product_reviews pr ON rp.asin = pr.asin\nWHERE pr.rate <= 3 \n   and rp.asin IN ('B0FFDYB7K8', 'B0DFYF2D7D', 'B0CGRQTH9P', 'B07WZPJ2LW')\n  AND pr.crawl_date = CURDATE()   -- ← 加这一行\nORDER BY rp.asin DESC;",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        -64,
        16
      ],
      "id": "afd0a7cc-c458-4c12-8ea4-ea25b5d137f8",
      "name": "节点 1：MySQL — 拉取所有竞品的 1~3 星差评",
      "credentials": {
        "mySql": {
          "id": "oqMufKKjm4zZ58JH",
          "name": "MySQL account"
        }
      }
    },
    {
