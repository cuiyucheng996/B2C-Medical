      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d7af7686-9cb6-4308-a25a-153e191a104b",
              "name": "all_reviews",
              "value": "=\"以下是商品的所有差评：\\n\\n{{$json.appended_review_text.join('\\n---\\n')}}\\n\\n请提取核心痛点，返回严格 JSON：\\n{\\n  \\\"top_pain_points\\\": [\\\"痛点1\\\", \\\"痛点2\\\", \\\"痛点3\\\"],\\n  \\\"pain_summary\\\": \\\"一句话总结\\\",\\n  \\\"improvement_suggestions\\\": [\\\"建议1\\\", \\\"建议2\\\"]\\n}\\n仅返回 JSON。\"",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        160
      ],
      "id": "92e62835-b497-4468-bb4a-a2e0e91076f8",
      "name": "节点 4：Set — 构建LLM差评分析提示词"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"qwen3.7-max\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"你是亚马逊商品评论分析专家。请只输出 JSON。\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.all_reviews) }}\n    }\n  ],\n  \"temperature\": 0.3,\n  \"response_format\": { \"type\": \"json_object\" }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        768,
        160
      ],
      "id": "fcbfcdd0-e1dc-48cd-ac2c-08a52dcdd8ad",
