      "id": "f03bf8a9-6082-4777-b881-53b02ec4925c",
      "name": "节点 6：Edit Fields — 解析返回"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE raw_products \nSET \n  pain_points = '{{ $json.pain_points }}',\n  pain_summary = '{{ $json.pain_summary }}'\nWHERE asin = '{{ $json.asin }}'\n  AND crawl_date = CURDATE();   -- ← 加这一行",
