      "credentials": {
        "httpBearerAuth": {
          "id": "6dxHYr4edgt8Xv9w",
          "name": "Bearer千问"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "67d6027f-1ff3-4bbe-b30e-50131a126a79",
              "name": "asin",
              "value": "={{ $('Loop Over Items').item.json.asin }}",
              "type": "string"
            },
            {
              "id": "a108fe16-b893-4e2b-8d77-d66d6303db6f",
              "name": "pain_points",
              "value": "={{ JSON.parse($json.choices[0].message.content).top_pain_points.join(\"|\") }}",
              "type": "string"
            },
            {
              "id": "4ed88360-8dfb-4a72-9d12-6775ec745428",
              "name": "pain_summary",
              "value": "={{ JSON.parse($json.choices[0].message.content).pain_summary }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
