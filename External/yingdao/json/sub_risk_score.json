      "parameters": {
        "operation": "executeQuery",
        "query": "/* =========================================================\n   等 LLM 风险分回来以后，再统一计算最终总分\n   注意：这里的 (100-risk_score) 实际存的是“安全分”\n   ========================================================= */\nUPDATE product_scores\nSET total_score = ROUND(\n    rule_score_80 + (100-risk_score) * 0.20,\n    1\n)\n  where asin='{{ $('节点 4：Edit Fields — 解析返回 JSON').first().json.asin }}'\n  ;",
