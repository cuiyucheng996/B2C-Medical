        "jsonBody": "={\n  \"model\": \"qwen3.7-max\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"=你是跨境电商市场风险分析专家。请分析以下商品的市场风险，返回严格 JSON 格式(注意：risk_summary字段中的内容请翻译成中文)：\\n商品：{{ $json.product_name }}\\n品类：{{ $json.category }}\\n售价：${{ $json.price }}\\n\\n请评估以下风险维度并返回 JSON：\\n{\\n  \\\"seasonal_risk\\\": 0-10,\\n  \\\"patent_risk\\\": 0-10,\\n  \\\"return_risk\\\": 0-10,\\n  \\\"policy_risk\\\": 0-10,\\n  \\\"total_risk_score\\\": 0-100,\\n  \\\"risk_summary\\\": \\\"一句话风险总结\\\"\\n}\\n仅返回 JSON，不要任何解释。\"\n    }\n  ],\n  \"temperature\": 0.3,\n  \"response_format\": {\"type\": \"json_object\"}\n}",
        "options": {}
