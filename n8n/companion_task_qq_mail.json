      "parameters": {
        "jsCode": "// 把陪聊推来的 payload 归一成邮件所需的 subject / text / when\n// kind 必须与 B2C src/tools/companion_tools.py 的 TASK_KINDS 一致\nconst KINDS = {\n  remind:      { prefix: '【复查提醒】', lead: '复查或随访提醒' },\n  checkin:     { prefix: '【打卡】',     lead: '打卡记录' },\n  medication:  { prefix: '【服药提醒】', lead: '服药提醒' },\n  appointment: { prefix: '【复诊预约】', lead: '复诊预约提醒' },\n  report:      { prefix: '【取报告】',   lead: '领取检查报告提醒' },\n};\nconst DEFAULTS = {\n  remind: '复查或随访',\n  checkin: '健康打卡',\n  medication: '按时服药',\n  appointment: '复诊挂号',\n  report: '领取检查报告',\n};\n\nconst src = $input.first().json;\nconst body = src.body && typeof src.body === 'object' ? src.body : src;\n\nconst kind = String(body.kind || 'remind').trim();\nconst meta = KINDS[kind] || KINDS.remind;\nconst fallbackTitle = DEFAULTS[kind] || DEFAULTS.remind;\n\nconst title = String(body.title || body.query || fallbackTitle).trim().slice(0, 120);\nconst whenText = String(body.when_text || '').trim();\n\nlet at = DateTime.fromISO(String(body.start_iso || '').trim(), { zone: 'Asia/Shanghai' });\nif (!at.isValid) {\n  at = DateTime.now().setZone('Asia/Shanghai');\n  if (kind !== 'checkin') at = at.plus({ days: 7 });\n}\nconst when = kind === 'checkin' ? at.toFormat('yyyy-LL-dd HH:mm') : at.toFormat('yyyy-LL-dd');\n\nconst lines = [\n  `${meta.prefix}${title}`,\n  `时间：${when}`,\n  whenText ? `你说的：${whenText}` : '',\n  body.user_id ? `用户：${body.user_id}` : '',\n  body.query ? `原话：${body.query}` : '',\n  '',\n  `（${meta.lead}，来自健康陪聊）`,\n];\n\nreturn [{ json: {\n  kind,\n  prefix: meta.prefix,\n  title,\n  when,\n  subject: `${meta.prefix}${title}`.slice(0, 120),\n  text: lines.filter(Boolean).join('\\n'),\n  user_id: body.user_id || '',\n  query: body.query || '',\n} }];"
      },
