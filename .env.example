# B2C business 本地密钥（复制为 .env 后填写）
# 与 config.yaml 同目录；不再回退上级 uvgraph/.env

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 工具信封后思考模型（空则回退 DASHSCOPE / DEEPSEEK）
# THINKING_API_KEY=
# THINKING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# THINKING_MODEL=qwen-plus

# 前缀缓存：system 块 cache_control + 默认 prompt_cache_key（关：COMPANION_PREFIX_CACHE=0）
# COMPANION_PREFIX_CACHE=1
# COMPANION_LLM_EXTRA_BODY={"prompt_cache_key":"companion-b2c-v1"}

# 语义回复缓存（Redis + embedding，短句、同 history 指纹）
# COMPANION_SEMANTIC_CACHE=1
# COMPANION_SEMANTIC_THRESHOLD=0.88
# COMPANION_SEMANTIC_TTL_SECONDS=86400
# COMPANION_SEMANTIC_MAX_ENTRIES=40

# 结构化输出：方法顺序 json_schema,function_calling,json_mode；校验失败最多回灌次数
# COMPANION_STRUCTURED_METHODS=json_schema,function_calling,json_mode
# COMPANION_STRUCTURED_MAX_REPAIR=3
# COMPANION_STRUCTURED_ESCALATE_MODEL=
# 本地 outlines JSON CFG（需 pip install outlines 且本地可推理模型）
# COMPANION_OUTLINES_JSON=0

# Brave Search MCP（config.yaml 中 brave_search.enabled=true 时需填）
# BRAVE_API_KEY=

# Dify 知识库（knowledge_pipe.sinks 含 dify 时写入）
# DIFY_API_KEY=
# DIFY_BASE_URL=http://127.0.0.1/v1
# DIFY_DATASET_ID=

# 记忆页(8015) 调陪聊(8002) 内部接口；两边要一致
# B2C_COMPANION_URL=http://127.0.0.1:8002
# B2C_INTERNAL_TOKEN=b2c-dev-internal

# 服务注册发现（先 docker compose -f deploy/registry/docker-compose.yml up -d）
# B2C_SERVICE_DISCOVERY=consul,nacos
# CONSUL_HTTP_ADDR=127.0.0.1:8500
# NACOS_SERVER_ADDR=127.0.0.1:8848
# B2C_SERVICE_HOST=127.0.0.1
# Consul 在 Docker 时探活宿主机（Windows 默认 host.docker.internal）
# B2C_CONSUL_HEALTH_HOST=host.docker.internal
# 网关容器通过 Consul 解析实例 IP 时用宿主机可达地址注册
# B2C_SERVICE_REGISTER_HOST=host.docker.internal
# B2C_COMPANION_SERVICE_NAME=b2c-companion
# 开启发现后勿设 B2C_COMPANION_URL，由 Consul/Nacos 解析陪聊地址

# 统一进门（deploy/gateway/up.ps1 → http://127.0.0.1:8080）
# 可选 Nacos 配置中心：先上传 data/config/nacos/b2c-business.env.example 为 b2c-business.env
# B2C_NACOS_CONFIG=1
# B2C_NACOS_CONFIG_DATA_ID=b2c-business.env

# 关场写记忆、文档/聊天附件解析走队列（默认开）。消费：uv run python server/worker/run.py
# B2C_ASYNC_HEAVY=1

# 可观测栈：deploy/observability/up.ps1（Prometheus + Alertmanager + Jaeger OTLP :4318）
# uv sync --group observability
# B2C_OTEL_ENABLED=true
# B2C_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Graphiti 官方 Docker 栈（uv run python server/graphiti/run.py，MCP 8016 / 图 UI 3016）
# OPENAI_API_KEY=  # Graphiti MCP 抽图必填；可与 DeepSeek 无关

# RAGFlow（未设置时回退上级 uvgraph/.env）
# RAGFLOW_EMAIL=b2c@ragflow.io
# RAGFLOW_PASSWORD=b2c_ragflow_2026
# RAGFLOW_API_KEY=your-ragflow-api-key
# RAGFLOW_ADMIN_EMAIL=admin@ragflow.io
# RAGFLOW_ADMIN_PASSWORD=admin

# 影刀 RPA MCP（config.yaml → mcp.servers.yingdao_rpa；未配齐时陪聊自动跳过该 MCP）
# 先在 server/mcp_server/yingdao 执行 npm install && npm run build
# YINGDAO_MCP_SCRIPT=server/mcp_server/yingdao/dist/index.js
# RPA_MODEL=openApi
# YINGDAO_ACCESS_KEY_ID=
# YINGDAO_ACCESS_KEY_SECRET=
# local 模式（API 与影刀须同机）：
# RPA_MODEL=local
# YINGDAO_SHADOWBOT_PATH=D://Program Files//影刀//ShadowBot.exe
# YINGDAO_USER_FOLDER=D://影刀//用户文件夹

# Playwright E2E（tests/scripts/run_e2e.ps1）；留空则脚本里自动注册临时用户
# E2E_LOGIN_NAME=
# E2E_LOGIN_PIN=1234
# E2E_BASE_URL=http://127.0.0.1:5173

